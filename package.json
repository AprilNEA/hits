{
	"name": "hits",
	"type": "module",
	"scripts": {
		"dev:workerd": "wrangler dev",
		"dev:node": "tsx --env-file-if-exists=.env --watch src/server.ts",
		"build": "tsx esbuild.config.ts",
		"start": "node dist/server.mjs",
		"deploy": "wrangler deploy --minify",
		"dev": "wrangler dev",
		"format": "biome format --write .",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test test/count.test.ts test/http.test.ts",
		"test:redis": "tsx --test test/redis.test.ts",
		"check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
		"check:worker": "wrangler deploy --dry-run"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"hono": "^4.13.9",
		"ioredis": "^6.0.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@cloudflare/workers-types": "^5.20260926.1",
		"@types/node": "^24.19.0",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"wrangler": "^4.141.0"
	},
	"private": true,
	"packageManager": "pnpm@10.33.4",
	"engines": {
		"node": ">=24"
	}
}
