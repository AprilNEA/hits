{
	"name": "hits",
	"type": "module",
	"scripts": {
		"dev:workerd": "wrangler dev",
		"dev:node": "tsx esbuild.config.ts --dev-node",
		"build": "tsx esbuild.config.ts",
		"build:client": "tsx esbuild.config.ts --client-only",
		"start": "node dist/server.mjs",
		"deploy": "wrangler deploy --minify",
		"dev": "wrangler dev",
		"format": "biome format --write .",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test test/count.test.ts test/http.test.ts",
		"test:redis": "tsx --test test/redis.test.ts",
		"check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
		"check:worker": "wrangler deploy --dry-run"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@hono/node-server": "^2.1.1",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.4.0",
		"hono": "^4.13.9",
		"ioredis": "^6.0.0",
		"lucide-react": "^1.48.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@cloudflare/workers-types": "^5.20260926.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^24.19.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"esbuild": "^0.28.2",
		"postcss": "^8.5.28",
		"shadcn": "^4.21.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"wrangler": "^4.141.0"
	},
	"private": true,
	"packageManager": "pnpm@10.33.4",
	"engines": {
		"node": ">=24"
	}
}
