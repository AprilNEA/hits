{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hits",
	"main": "src/workerd.ts",
	"compatibility_date": "2026-09-26",
	"build": {
		"command": "pnpm build:client",
		"watch_dir": ["src/ui", "esbuild.config.ts"]
	},
	"assets": { "directory": "./dist/public" },
	"durable_objects": {
		"bindings": [{ "name": "COUNTERS", "class_name": "CloudflareCounter" }]
	},
	// New deployments only. Existing deployments must retain their namespace and migration history.
	"exports": {
		"CloudflareCounter": { "type": "durable-object", "storage": "sqlite" }
	}
}
